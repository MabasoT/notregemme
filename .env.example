# ─── Public (exposed to the browser — NEXT_PUBLIC_ prefix) ─────────────
# Canonical origin, no trailing slash. Drives canonical tags, sitemap,
# robots.txt, llms.txt and JSON-LD. Defaults to https://notregemme.co.za.
NEXT_PUBLIC_SITE_URL=https://notregemme.co.za

# Optional. Google Apps Script /exec URL returning live stock JSON keyed by
# product slug (see docs/STOCK-AND-SOCIAL-PROOF.md). Empty → lib/stock.ts.
NEXT_PUBLIC_STOCK_URL=

# ─── Server-only (NEVER prefix with NEXT_PUBLIC_) ──────────────────────
# Google Apps Script /exec URL for newsletter + drop-alert sign-ups.
# Deploy docs/subscribe-backend.gs and paste its URL here. While empty,
# the forms offer a pre-filled WhatsApp message instead.
SUBSCRIBE_SCRIPT_URL=
